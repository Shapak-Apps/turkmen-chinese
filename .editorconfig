# https://editorconfig.org
# Редакторы читают этот файл сами; в VS Code нужно расширение EditorConfig.

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# В Markdown два пробела в конце строки — это перенос, их убирать нельзя
[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
